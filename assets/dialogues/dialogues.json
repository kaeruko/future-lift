      "logic": "all",
      "conditions": []
    },
    {
      "id": "bear_default_3",
      "residentId": "06_bear",
      "text": "学んだり、人とつながったりすることも、生活する力のひとつだね。",
      "priority": 0,
      "once": false,
      "logic": "all",
      "conditions": []
    },
    {
      "id": "bear_default_4",
      "residentId": "06_bear",
