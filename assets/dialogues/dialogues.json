    },
    {
      "id": "037_tora_001",
      "residentId": "037_tora",
      "text": "よーし！とらおコーチだ！今日も自分のペースで体を動かそう！",
      "priority": 0,
      "once": false,
      "logic": "all",
      "conditions": []
    },
    {
      "id": "037_tora_002",
      "residentId": "037_tora",
      "text": "走るとひざの軟骨がすり減るって？必ずしもそうじゃないぞ！適度なランニングは関節にもいい刺激になるんだ！",
      "priority": 0,
